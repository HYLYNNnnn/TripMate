# Firebase configuration
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=

# Google Maps
REACT_APP_MAPS_BROWSER_KEY=

# Backend API
REACT_APP_API_BASE=

# Explicit development fixtures; keep false for normal API integration
REACT_APP_USE_MOCK_DATA=false

# Complete local demo: sample recommendations and a key-free OpenStreetMap map
# Use together with the backend's demo profile.
REACT_APP_DEMO_MODE=false
